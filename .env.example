# Application
PORT=3000

# Database
DATABASE_URL="postgresql://petcare:petcare_password@localhost:5432/petcare?schema=public"

# JWT
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token expiration
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"
